{
  "compilerOptions": {
    "composite": true,
    "outDir": "./.tsc-out",
    "tsBuildInfoFile": "./.tsc-out/tsconfig.node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "vite-env.d.ts"]
}
