# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Postgres / PostGIS (Supabase-hosted)
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI, "Transaction" pooler for serverless, "Session" for a long-lived server like this one)
# Use the Session pooler (port 5432) or direct connection for this app, not the Transaction pooler (6543), since we hold a persistent pg.Pool.
DATABASE_URL=postgres://postgres.xxxxxxxxxxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=gigsync-media
R2_PUBLIC_URL=
