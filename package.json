{
  "name": "gigsync",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run build:client && tsx server/src/index.ts",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build": "npm run build:client && npm run build:server",
    "start": "node server/dist/index.js",
    "lint": "npm run typecheck --workspace=client && npm run typecheck --workspace=server"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.45.0",
    "tailwindcss": "^4.3.3"
  }
}
